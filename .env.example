# Supabase (public keys are safe for client-side use)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Legacy alternative:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_JWT

# Admin access control — the only email allowed into /admin
ADMIN_EMAIL=you@example.com

# Canonical site URL (used by robots.txt + sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://discover-oroquieta.example.com